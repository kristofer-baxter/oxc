function Component(props) {
	let count = 0;
	const bad = () => count++;
	const run = async () => {
		await 0;
		bad();
	};
	const safe = _temp;
	const m = new Map();
	m.set("k", run);
	for (let i = 0; i < 2; i++) {
		m.set("k", safe);
	}
	m.set("k", safe);
	m.get("k")();
	return null;
}
function _temp() {}
